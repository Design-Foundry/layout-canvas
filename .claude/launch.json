{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "server/src/Canvas.Server", "--launch-profile", "http"],
      "port": 5180
    },
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@canvas/client", "start"],
      "port": 4200
    },
    {
      "name": "wasm",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-u", "-m", "http.server", "8080", "--bind", "127.0.0.1", "-d", "visualcore/build/wasm-debug"],
      "port": 8080
    }
  ]
}
